#include <WiFi.h>
#include "Hardware.h"
#include "RemoteLink.h"
#include "RemoteMqtt.h"

WiFiServer web(80);uint32_t wifiAt=0;bool naptEnabled=false;
uint8_t hx(char c){return c>='0'&&c<='9'?c-'0':c>='A'&&c<='F'?c-'A'+10:c>='a'&&c<='f'?c-'a'+10:0;}
String dec(const String&s){String o;o.reserve(s.length());for(size_t i=0;i<s.length();i++){char c=s[i];if(c=='+')o+=' ';else if(c=='%'&&i+2<s.length()){o+=(char)((hx(s[i+1])<<4)|hx(s[i+2]));i+=2;}else o+=c;}return o;}
String esc(const String&s){String o;o.reserve(s.length()+4);for(char c:s){if(c=='\\'||c=='\"')o+='\\';if((uint8_t)c>=0x20)o+=c;}return o;}
String arg(const String&q,const String&b,const char*k){String key=String(k)+"=";auto scan=[&](const String&s)->String{int p=0;while(p<(int)s.length()){int e=s.indexOf('&',p);if(e<0)e=s.length();if(s.substring(p,p+key.length())==key)return dec(s.substring(p+key.length(),e));p=e+1;}return "";};String v=scan(q);return v.length()?v:scan(b);}
void send(WiFiClient&c,int code,const char*type,const String&body){const char*msg=code==200?"OK":code==400?"Bad Request":code==404?"Not Found":"Conflict";c.print("HTTP/1.1 ");c.print(code);c.print(' ');c.print(msg);c.print("\r\nContent-Type: ");c.print(type);c.print("\r\nContent-Length: ");c.print(body.length());c.print("\r\nConnection: close\r\nCache-Control: no-store\r\n\r\n");c.print(body);}
String scanJson(){int n=WiFi.scanNetworks(false,true,false,250);String j="{\"networks\":[";for(int i=0;i<n;i++){if(i)j+=',';j+="{\"ssid\":\""+esc(WiFi.SSID(i))+"\",\"rssi\":"+String(WiFi.RSSI(i))+",\"secure\":"+(WiFi.encryptionType(i)==WIFI_AUTH_OPEN?"false":"true")+",\"channel\":"+String(WiFi.channel(i))+"}";}WiFi.scanDelete();return j+"]}";}
void startAP(){WiFi.persistent(false);WiFi.mode(WIFI_AP_STA);WiFi.setSleep(false);IPAddress ip(192,168,4,1),mask(255,255,255,0),dhcp(192,168,4,100);WiFi.softAPConfig(ip,ip,mask,dhcp);WiFi.softAP(Cfg::SSID);naptEnabled=false;}
void gatewayUpdate(){bool w=remoteInternetReady();if(w!=naptEnabled&&WiFi.AP.enableNAPT(w))naptEnabled=w;}
void wifiWatch(){if(millis()-wifiAt<5000)return;wifiAt=millis();if(!(WiFi.getMode()&WIFI_AP)||WiFi.softAPIP()!=IPAddress(192,168,4,1)){if(naptEnabled)WiFi.AP.enableNAPT(false);WiFi.softAPdisconnect(true);startAP();}}
void httpUpdate(){WiFiClient c=web.accept();if(!c)return;c.setTimeout(250);String line=c.readStringUntil('\n');line.trim();int a=line.indexOf(' '),z=line.indexOf(' ',a+1);if(a<1||z<a){c.stop();return;}String method=line.substring(0,a),target=line.substring(a+1,z),body;int qi=target.indexOf('?');String path=qi<0?target:target.substring(0,qi),q=qi<0?"":target.substring(qi+1);int len=0;while(c.connected()){line=c.readStringUntil('\n');line.trim();if(!line.length())break;if(line.startsWith("Content-Length:"))len=line.substring(15).toInt();}if(len>0&&len<2048){uint32_t until=millis()+300;while((int)body.length()<len&&c.connected()&&(int32_t)(until-millis())>0){while(c.available()&&(int)body.length()<len)body+=(char)c.read();delay(1);}}auto A=[&](const char*k){return arg(q,body,k);};
if(path=="/")send(c,200,"text/plain",Cfg::FW);else if(path=="/drive"){String l=A("l"),r=A("r");if(!l.length()||!r.length())send(c,400,"text/plain","BAD");else{linkHeartbeat();driveSet(constrain(l.toInt(),-100L,100L),constrain(r.toInt(),-100L,100L));send(c,200,"text/plain","OK");}}else if(path=="/stop"||path=="/motion/stop"){motionStop();send(c,200,"text/plain","OK");}else if(path=="/estop"){emergencyStop();send(c,200,"text/plain","OK");}else if(path=="/sensor/off"){sensorPowerOff();send(c,200,"text/plain","OK");}else if(path=="/heartbeat"){if(A("arm")=="0"){linkSetArmed(false);send(c,200,"text/plain","DISARMED");}else{linkHeartbeat();send(c,200,"text/plain","OK");}}else if(path=="/remote/status"){String j=remoteStatusJson();if(j.endsWith("}")){j.remove(j.length()-1);j+=",\"napt\":";j+=naptEnabled?"true":"false";j+='}';}send(c,200,"application/json",j);}else if(path=="/remote/scan")send(c,200,"application/json",scanJson());else if(path=="/remote/provision"&&method=="POST"){String s=A("ssid"),p=A("password");bool ok=s.length()&&remoteProvision(s,p);send(c,ok?200:400,"application/json",ok?"{\"ok\":true}":"{\"ok\":false}");}else if(path=="/remote/clear"&&method=="POST"){if(A("confirm")!="1")send(c,400,"application/json","{\"ok\":false}");else{remoteMqttDisconnect();if(naptEnabled)WiFi.AP.enableNAPT(false);naptEnabled=false;remoteClear();send(c,200,"application/json","{\"ok\":true}");}}else if(path=="/relay"){String v=A("mask");if(v!="0"&&v!="1")send(c,409,"text/plain","MQ POWER MUST BE 0 OR 1");else{linkHeartbeat();send(c,relaySetMask(v=="1")?200:409,"text/plain","OK");}}else if(path=="/measure"){String x=A("cmd");if(x=="start"){linkHeartbeat();measureStart();send(c,200,"text/plain","OK");}else if(x=="cancel"){measureCancel();send(c,200,"text/plain","OK");}else send(c,400,"text/plain","BAD");}else if(path=="/alert"){if(A("cmd")=="test"){alertTest();send(c,200,"text/plain","OK");}else{String sv=A("severity");long s=sv.toInt();if(!sv.length()||s<0||s>2)send(c,409,"text/plain","BAD");else{String tv=A("ttl");uint32_t ttl=tv.length()?constrain(tv.toInt(),500L,10000L):3000;send(c,alertSet((uint8_t)s,ttl)?200:409,"text/plain","OK");}}}else if(path=="/data")send(c,200,"application/json",dataJson());else if(path=="/diag")send(c,200,"application/json",diagJson());else if(path=="/cfg"){String v;if((v=A("cam")).length())settings.cam=v;if((v=A("speed")).length())settings.speed=constrain(v.toInt(),20L,100L);if((v=A("warm")).length())settings.warm=constrain(v.toInt(),0L,3600L);if((v=A("measure")).length())settings.measure=constrain(v.toInt(),5L,600L);if(q.length()||body.length())saveSettings();send(c,200,"application/json",settingsJson());}else send(c,404,"text/plain","NOT FOUND");c.stop();}
void setup(){hwBegin();startAP();remoteBegin();remoteMqttBegin();web.begin();}void loop(){hwUpdate();remoteUpdate();gatewayUpdate();remoteMqttUpdate();httpUpdate();wifiWatch();delay(1);}
